# Vooads settings. On Railway, paste these into your service → Variables (not into a file).
# Locally: copy this to .env and run with  node --env-file=.env --no-warnings server/index.js
# Each Railway environment (production, staging, PR previews) has its OWN variables. Never copy production's
# APP_SECRET or live payment keys into staging.

# --- Required (the only one) ---
# A long random string (64+ characters). Encrypts saved API keys and secrets and signs logins. NEVER change it after
# launch (saved keys could no longer be read). Use a DIFFERENT one on staging.
# Make one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#       or:  openssl rand -hex 48
APP_SECRET=

# --- Optional: first admin ---
# Log in at /admin with this email. If you leave it empty, the server log prints a one-time setup link instead.
OWNER_EMAIL=you@yourcompany.com

# --- Which copy of the site this is (normally automatic) ---
# production | staging | development. On Railway it follows the environment name: "production" → production,
# any other environment (staging, PR previews) → staging. Off Railway: NODE_ENV=production → production, else development.
# APP_ENV=staging
# Staging only: who may get real emails besides active staff and OWNER_EMAIL (comma list of emails or @domains).
# Everyone else's emails (login codes too) are printed in the server log instead.
# STAGING_EMAIL_ALLOWLIST=qa@zedapex.com,@zedapex.com

# --- Set automatically on Railway (only set them yourself to override) ---
# NODE_ENV=production            (Railway → production automatically; staging also runs with production settings)
# APP_URL=https://vooads.com     (defaults to https://$RAILWAY_PUBLIC_DOMAIN; or set it in Admin → Integrations)
# DATA_DIR=/data                 (defaults to the attached Volume's mount path, $RAILWAY_VOLUME_MOUNT_PATH)
# PORT=3000                      (Railway sets it)
# RAILWAY_GIT_COMMIT_SHA         (Railway sets it on GitHub deploys; /healthz shows it as "version")

# --- Safety and operations (defaults are right for Railway) ---
# BACKUP_ON_BOOT=1               Copy the database to DATA_DIR/backups before migrations at every start (newest 10 kept). 0 = off.
# REQUIRE_FFMPEG=1               /healthz fails without ffmpeg (always on when running on Railway).
# MIRROR_MEDIA=1                 Copy finished videos from the AI provider to the Volume (provider links expire). 0 = off.
# FFMPEG_PATH=ffmpeg  FFPROBE_PATH=ffprobe  FFMPEG_THREADS=  FFMPEG_CONCURRENCY=   Only if ffmpeg lives somewhere unusual.

# --- Everything below can be set in Admin → Integrations instead (values saved there win) ---
# Email (login codes, receipts, onboarding emails, campaigns). resend.com → API Keys. Without a key, emails are printed in the logs.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=         (Resend → Webhooks → signing secret; webhook URL {APP_URL}/api/webhooks/mail/resend)
# FROM_EMAIL=Vooads <hello@vooads.com>
# SUPPORT_EMAIL=support@vooads.com
# COMPANY_NAME=Zedapex
# VooSquare shared login, events and support inbox (easiest: Admin → Integrations → Connect VooSquare)
# Voo Connect (VooSquare login, payment events, summary card). Values from VooSquare → Admin → Products → Vooads →
# Credentials. Admin → Integrations → VooSquare wins over these.
# VOO_BASE=https://voosquare.com
# VOO_CLIENT_ID=vsc_...
# VOO_CLIENT_SECRET=vss_...
# VOO_API_KEY=vsk_...
# VOO_SIGNAL_SECRET=          # openssl rand -hex 32, make once, never change
# VOO_SERVER_BASE=            # only for a private server-to-server address
# VOO_REDIRECT_URI=           # only if it is not APP_URL/auth/voosquare/callback
# VOO_CONNECT=off             # switches every VooSquare feature off
# VOO_ISSUER=                 # older OpenID setting, not used for login any more
# VOO_SERVICE_KEY=
# VOO_WEBHOOK_SECRET=
# VOO_EVENTS_URL=
# VOO_SUPPORT_EVENTS_URL=

# AI keys (fal.ai, ElevenLabs, Anthropic/OpenAI) and payment keys (Gatevoo, Stripe, Paystack, ...) are never set here.
# Add them in /admin → AI providers and /admin → Payment methods, then press Test in /admin → Integrations.

# --- Local development only ---
# MOCK_RENDER_MS=1200            How long a demo (no key) render pretends to take.
# JOB_TICK_MS=2500               How often the job worker runs.

# Bachs (naira and African payments): keys go in Admin → Payment methods → Bachs. Only for tests:
# BACHS_ALLOW_SANDBOX=true    # show a sk_sandbox_ key to customers outside staging (never on the live site)
# BACHS_API_BASE=             # point Bachs at a fake server (self-checks only)
